# The toolchain image for everything in this repository except code generation (which stays in the
# ondewo-cpp-proto-compiler image): the CMake build of the committed stubs, the test suite, the
# release archive and every gh call of a release. The Makefile runs it as the invoking user with the
# repository mounted at its own path, so a host needs only make, git, docker and perl.
#
# ubuntu:24.04 because it ships exactly the protobuf / gRPC the compiler image pins (Debian trixie,
# ARG PROTOBUF_VERSION=3.21.12 / ARG GRPC_VERSION=1.51.1 in ondewo-proto-compiler/cpp/Dockerfile).
# protobuf C++ has no cross-version gencode/runtime guarantee - the committed api/ carries an
# #error poison pill otherwise - so moving this base image means re-checking those two ARGs first.
FROM ubuntu:24.04

ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

ARG PROTOBUF_VERSION=3.21.12
ARG GRPC_VERSION=1.51.1

# The packages .github/workflows/ci.yml installs on its runner (the compiler image's toolchain plus
# GoogleTest) except gcovr - `make coverage` never runs in this image - and make/git/perl/curl for
# the Makefile recipes that run in here.
RUN apt-get update -qq \
  && apt-get install -y -qq --no-install-recommends \
    build-essential ca-certificates cmake curl git make perl pkg-config \
    protobuf-compiler libprotobuf-dev \
    protobuf-compiler-grpc libgrpc++-dev libgrpc-dev libabsl-dev \
    libgtest-dev \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Fail the image build, not the release, when the archive moved away from the pinned ABI.
# Prefix-matched like the compiler image, so an Ubuntu point update (3.21.12-8.2ubuntu0.1) passes.
RUN set -e; \
    installed_protobuf="$(dpkg-query -W -f='${Version}' libprotobuf-dev)"; \
    installed_grpc="$(dpkg-query -W -f='${Version}' libgrpc++-dev)"; \
    case "$installed_protobuf" in \
      "$PROTOBUF_VERSION"|"$PROTOBUF_VERSION"-*) ;; \
      *) echo "ERROR: libprotobuf-dev is '$installed_protobuf', not $PROTOBUF_VERSION - api/ was generated by protoc $PROTOBUF_VERSION" >&2; exit 1 ;; \
    esac; \
    case "$installed_grpc" in \
      "$GRPC_VERSION"|"$GRPC_VERSION"-*) ;; \
      *) echo "ERROR: libgrpc++-dev is '$installed_grpc', not $GRPC_VERSION" >&2; exit 1 ;; \
    esac; \
    echo "toolchain OK: protobuf=$installed_protobuf grpc=$installed_grpc"

# The GitHub CLI, installed the same way as in the sibling clients' Dockerfile.utils.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends gh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
